{
  "name": "myos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "build:single": "tsc -b && vite build --mode single",
    "check:engine": "tsx --tsconfig tsconfig.app.json scripts/check-engine.ts",
    "check:sync": "tsx --tsconfig tsconfig.app.json scripts/check-sync.ts",
    "check:rewards": "tsx --tsconfig tsconfig.app.json scripts/check-rewards.ts",
    "check:token": "tsx --tsconfig tsconfig.app.json scripts/check-token.ts",
    "check:recurrence": "tsx --tsconfig tsconfig.app.json scripts/check-recurrence.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@supabase/supabase-js": "^2.117.2",
    "@walletconnect/ethereum-provider": "^2.25.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "viem": "^2.57.3",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
